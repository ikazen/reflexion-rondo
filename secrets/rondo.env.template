# reflexion-rondo 필수 환경변수 템플릿
# 실제 값을 채운 뒤 rondo.env 로 저장하고 sops로 암호화한다:
#   cp secrets/rondo.env.template secrets/rondo.env
#   <값 채우기>
#   sops --encrypt secrets/rondo.env > secrets/rondo.enc.env
#   rm secrets/rondo.env

# Postgres
RONDO_DB_URL=postgresql://rondo:CHANGEME@localhost:5432/rondo

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Ollama 로컬 임베딩 (Mac Ollama 서버)
OLLAMA_BASE_URL=

# Ollama Cloud (추론)
OLLAMA_CLOUD_BASE_URL=
OLLAMA_API_KEY=

# Airflow (없으면 direct 모드로 동작)
AIRFLOW_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=

# 페이싱 (0=비활성)
OLLAMA_CLOUD_SESSION_HOURS=5.0
OLLAMA_CLOUD_SESSION_CYCLES=0
OLLAMA_CLOUD_WEEKLY_CYCLES=0
